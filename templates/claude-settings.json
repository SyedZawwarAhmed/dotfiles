{
  "permissions": {
    "allow": [
      "Agent(*)"
    ]
  },
  "model": "opus[1m]",
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "voiceEnabled": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/skills/tmux-window-name/tmux-window-name\" hook-session-start",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/skills/tmux-window-name/tmux-window-name\" hook-prompt",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/skills/tmux-window-name/tmux-window-name\" hook-end",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/skills/tmux-window-name/tmux-window-name\" hook-notify",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/skills/tmux-window-name/tmux-window-name\" hook-stop",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  }
}
